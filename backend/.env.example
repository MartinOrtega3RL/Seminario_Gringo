# =====================================================================
#  Variables de entorno del backend
#  Copiar este archivo como .env y completar los valores de la maquina.
#  El archivo .env NO se versiona: lleva la contrasena de la base.
#
#  El servidor valida estas variables al arrancar (src/config/entorno.js).
#  Si falta una, no levanta y dice cual.
# =====================================================================

# --- Base de datos MySQL ---------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_comercial
DB_USER=
DB_PASSWORD=

# --- Servidor HTTP ----------------------------------------------------
PORT=3000
# Origen desde el que se permite consumir la API (el frontend en desarrollo)
ORIGEN_FRONTEND=http://localhost:5173

# --- Firma de los tokens de sesion ------------------------------------
# Minimo 32 caracteres. Generar uno propio, no reutilizar este texto:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=REEMPLAZAR_POR_UNA_CADENA_ALEATORIA_DE_48_BYTES
JWT_VIGENCIA=8h

# --- Registro en consola ----------------------------------------------
# trace | debug | info | warn | error | fatal
# Si se omite: debug en desarrollo, info en produccion.
NIVEL_REGISTRO=debug
NODE_ENV=development
